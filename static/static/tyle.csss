:root{color-scheme:light;--ink:#233044;--teal:#059a71;--red:#d73b47}*{box-sizing:border-box}body{margin:0;background:#f7fafb;color:var(--ink);font:14px/1.5 system-ui,sans-serif}header{height:68px;background:white;border-bottom:1px solid #e5ecef;display:flex;justify-content:space-between;align-items:center;padding:0 26px}.brand{color:var(--teal);font-size:28px;letter-spacing:-1px}.brand small{font-size:12px;letter-spacing:0;font-weight:400}.environment{color:var(--teal);font-size:12px;text-align:right}.environment small{display:block;color:#6d7889}.shell{display:grid;grid-template-columns:160px 1fr;max-width:1500px;margin:auto;min-height:calc(100vh - 68px)}nav{padding:24px 10px;background:#f0f6f7;border-right:1px solid #e5ecef}nav button{display:block;width:100%;text-align:left;background:transparent;color:#647285;border:0;margin-bottom:10px}nav button.active{background:#dff5ed;color:#057a5d;font-weight:700}main{padding:26px;min-width:0}.heading{display:flex;justify-content:space-between;align-items:center;gap:14px;margin-bottom:22px}h1{font-size:24px;margin:0}h2{font-size:15px;margin:0 0 14px}h3{font-size:14px}p{margin:8px 0 14px}#subtitle{color:#6b788d;font-size:12px;margin:4px 0}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:20px}.metric{background:#edfaf4;border:1px solid #ddefe6;border-radius:6px;padding:18px}.metric strong{font-size:28px;display:block;color:#177b62}.metric.bad{background:#fff1f2;border-color:#f8dce0}.metric.bad strong{color:var(--red)}section{background:white;padding:20px;border:1px solid #e2e9ec;border-radius:6px;margin-bottom:20px}.columns{display:grid;grid-template-columns:1fr 1fr;gap:20px}.charts{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:16px}.charts section{min-height:235px}button,select,input{font:inherit;min-height:44px;border-radius:5px;border:1px solid #d7e1e5;padding:8px 12px}button{cursor:pointer;background:var(--teal);color:white}button:disabled{opacity:.45;cursor:default}#refresh{background:white;color:#647285}select,input{width:100%;background:white;color:var(--ink)}label{display:block;margin-bottom:8px}.seats{display:grid;grid-template-columns:repeat(6,1fr);gap:8px}.seat{padding:8px;background:#edfaf4;color:#087457;font-weight:600}.seat.chosen{background:var(--teal);color:white}.seat:disabled{background:#eee;color:#666}.muted,footer,.scope{color:#6d7889;font-size:12px}.error{color:var(--red)}.alert{border-left:3px solid var(--red);padding:12px;background:#fff4f4;margin:10px 0}.trace{display:flex;width:100%;justify-content:space-between;text-align:left;background:#f7fafb;color:var(--ink);margin:8px 0;gap:12px;flex-wrap:wrap}.trace.error{color:var(--red)}code{overflow-wrap:anywhere;font-size:12px}pre{white-space:pre-wrap;overflow-wrap:anywhere;background:#f7fafb;padding:14px;font-size:12px}.span{border-left:3px solid var(--teal);padding:10px;margin:8px 0}.span .bar{height:10px;background:#66cfa4;min-width:3px;margin:8px 0}footer{display:flex;justify-content:space-between;border-top:1px solid #e2e9ec;padding:12px 0}.log-row{display:grid;grid-template-columns:62px 48px 1fr;gap:8px;font-size:11px;border-bottom:1px solid #edf0f3;padding:9px 0}.badge{background:#ddf5e9;color:#087457;padding:2px 5px;border-radius:3px}.badge.warn{background:#fff0cf;color:#a76c00}.bar-row{margin:14px 0;font-size:11px}.bar-track{background:#eef4f5;height:19px;margin:5px 0}.bar-fill{background:#33bc8d;height:19px;min-width:1px}.donut{width:115px;height:115px;border-radius:50%;margin:15px auto;display:grid;place-items:center}.donut div{background:white;border-radius:50%;width:78px;height:78px;display:grid;place-items:center;font-weight:700}svg{width:100%;height:160px}.chart-note{font-size:11px;color:#6d7889}[hidden]{display:none!important}@media(max-width:850px){.charts{grid-template-columns:1fr}.columns{grid-template-columns:1fr;gap:0}.shell{grid-template-columns:125px 1fr}main{padding:16px}.metrics{grid-template-columns:1fr 1fr}}@media(max-width:560px){header{padding:12px;height:auto;gap:12px}.brand{font-size:22px}.environment small{max-width:140px}.shell{display:block}nav{display:flex;flex-wrap:wrap;padding:8px;gap:5px;border-right:0;border-bottom:1px solid #e5ecef}nav button{width:auto;font-size:12px;margin:0;padding:6px 9px}.heading{align-items:flex-start}h1{font-size:21px}.metric{padding:12px}.metric strong{font-size:23px}.seats{grid-template-columns:repeat(4,1fr)}section{padding:16px}footer{display:block}footer span{display:block}}
